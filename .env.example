EXPO_PUBLIC_MAPBOX_TOKEN=your-mapbox-public-token
EXPO_PUBLIC_SUPABASE_URL=your-supabase-project-url
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Google's official public test IDs (safe to use as-is — never real ads/revenue).
# Replace with real per-platform IDs from the AdMob console before launch.
EXPO_PUBLIC_ADMOB_IOS_APP_ID=ca-app-pub-3940256099942544~1458002511
EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=ca-app-pub-3940256099942544~3347511713
EXPO_PUBLIC_ADMOB_IOS_BANNER_ID=ca-app-pub-3940256099942544/2934735716
EXPO_PUBLIC_ADMOB_ANDROID_BANNER_ID=ca-app-pub-3940256099942544/6300978111

# RevenueCat public SDK keys, from the RevenueCat dashboard's Project
# Settings → API Keys → App Store / Play Store.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=your-revenuecat-ios-public-sdk-key
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=your-revenuecat-android-public-sdk-key

# Google Maps Android SDK key (Google Cloud Console → APIs & Services →
# Credentials), restricted to com.garagehunt.app's package name + release
# SHA-1. Required for the Discover map screen on Android — react-native-maps
# has no non-Google provider there, unlike iOS's Apple Maps default.
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_API_KEY=your-google-maps-android-api-key
